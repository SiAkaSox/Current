{
## COLLECTION LOG ITEMS
##
## Only the itemIds listed here are recorded in a player's collection log. The server loads this file at startup.
## Lines starting with ## are notes. Lines starting with a single # are ready-made examples: remove the # to use one.
## Comments only work INSIDE the outer { } and the file must not have a trailing comma before a ] or }.
## Rules for adding an entry to a category:
##   - If it is the first entry in that category, uncomment the example as it is (it starts with {).
##   - If entries already exist above it, the example starts with ,{ so the comma is already in place.
## "npcs" (optional) lists the NPC names an entry covers, exactly as they appear in game, e.g. [ "Mossback Rat" ].
##   Only drops from those NPCs (or from a source named like the entry) unlock the entry's items, so an item that two
##   monsters share is unlocked separately for each. The kills of those NPCs are the kill count shown for the entry.
##   Entry names must be unique: they are how each player's progress is saved.
## "name" is the entry's identity for saved progress. The category an entry sits in must match its tab in the in-game log, and so must its order (cache structs 719+ are built in file order).
## NOTE: this file does not create the entry in the in-game log. The left-hand list and the item grid come from the cache (structs 471-475).

  "Bosses": [
    {
      "name": "Mossback Rats",
      "npcs": [ "Mossback Rat" ],
      "items": [
        ## add item ids here, one per line, e.g.   { "itemId": 12345 },   (no comma after the last one)
        { "itemId": 59116 }
      ]
    },
    {
      "name": "Dusklings",
      "npcs": [ "Duskling" ],
      "items": [
        ## add item ids here, one per line, e.g.   { "itemId": 12345 },   (no comma after the last one)
      ]
    }
    ## Example boss entry (real REIGN data). Uncomment to add; the leading comma joins it to the entry above:
    # ,{
    #   "name": "Abyssal Sire",
    #   "items": [
    #     { "itemId": 15312 },
    #     { "itemId": 13273 },
    #     { "itemId": 7979 },
    #     { "itemId": 13274 },
    #     { "itemId": 13275 },
    #     { "itemId": 13276 },
    #     { "itemId": 13277 },
    #     { "itemId": 13265 },
    #     { "itemId": 4151 }
    #   ]
    # }
  ],

  "Raids": [
    ## Example raid entry (first 4 of 22 items). This category is empty, so there is no leading comma:
    # {
    #   "name": "Chambers of Xeric",
    #   "items": [
    #     { "itemId": 20851 },
    #     { "itemId": 22386 },
